# ==============================================================================
# Census Comparison Agent - .gitignore
# ==============================================================================

# Environment variables & secrets (Never commit API keys)
.env
.env.*
!.env.example

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/
.paddleocr/
paddleocr_models/

# Pipeline Run Directories (Input files with PII/PHI & generated deliverables)
input/*
!input/.gitkeep
output/*
!output/.gitkeep
extracted_text/*
!extracted_text/.gitkeep

# Temporary scratch and test output folders
backend/scratch_output/
backend/scratch_output2/
backend/scratch_output3/
backend/test_out/
backend/cache_storage/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal
scratch/*
!scratch/.gitkeep

# Learning Engine Runtime Runs & Feedback
learning_engine_data/runs/*
!learning_engine_data/runs/.gitkeep
learning_engine_data/feedback/*
!learning_engine_data/feedback/.gitkeep

# Temporary, lock, and backup files
~$*.xlsx
~$*.docx
~$*.doc
~$*.xls
~$*
*.tmp
*.temp
*.bak
*.orig

# Logs
*.log
logs/

# IDE & Editor Settings
.vscode/
.idea/
.cursor/
*.code-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Distribution / Packaging
build/
dist/
.eggs/
*.egg-info/
*.egg
*.whl
